// @ts-check
/**
 * @deepseek-ai/dsh-external-brain — DSH 侧对接插件（伪装成目标 API）。
 *
 * 对外提供一个 OpenAI 兼容的 POST /v1/chat/completions 端点（默认
 * http://127.0.0.1:3080/v1），供 NEKO 侧 external_control 插件转发对话
 * 请求过来。收到请求后用 DSH 自己的 llm 通道生成回复，并按 OpenAI 格式
 * 返回（支持非流式 / 流式 SSE）。
 *
 * 对接约定：
 *   - NEKO 侧 external_control 监听 9157，把 NEKO 对话请求转发到此 3080/v1。
 *   - 本插件即"目标 API"，用 DSH 大脑回答。
 */
import z from "@deepseek-ai/schemastery";

/** Stable Cordis plugin name. */
export const name = "dsh-external-brain";

/** Required services. */
export const inject = ["webServer", "llm"];

/** Plugin config (schemastery schema). */
export const Config = z.object({
	/** Provider to call through ctx.llm. */
	provider: z.string().default("deepseek-official"),
	/** Model id passed to the llm provider. */
	model: z.string().required(),
	/** Allow the caller's body.model to override the configured model. */
	allowModelOverride: z.boolean().default(false),
});

/** Read a JSON body from an incoming request. */
async function readJsonBody(req, limit = 32 * 1024 * 1024) {
	let size = 0;
	const chunks = [];
	for await (const chunk of req) {
		size += chunk.length;
		if (size > limit) throw new Error("request body too large");
		chunks.push(chunk);
	}
	const raw = Buffer.concat(chunks).toString("utf8");
	if (raw === "") return {};
	return JSON.parse(raw);
}

/** Normalize OpenAI-style messages into DSH harness messages. */
function toHarnessMessages(messages) {
	if (!Array.isArray(messages)) return [];
	const out = [];
	for (const m of messages) {
		const role = typeof m?.role === "string" ? m.role : "user";
		let text = "";
		if (Array.isArray(m?.content)) {
			text = m.content
				.filter((b) => b && typeof b === "object" && (b.type === "text" || b.type === "input_text"))
				.map((b) => (typeof b.text === "string" ? b.text : String(b.text ?? "")))
				.join("");
		} else if (typeof m?.content === "string") {
			text = m.content;
		}
		const normalized = role === "system" ? "system" : role === "assistant" ? "assistant" : "user";
		out.push({ role: normalized, content: [{ type: "text", text }] });
	}
	return out;
}

/**
 * Handle a /api/tools remote-tool callback from N.E.K.O.
 * Payload: { name, arguments: { messages }, call_id }. Respond with
 * { output: <result> } per the tools callback protocol.
 */
export async function handleToolCallback(req, res, cfg, llm) {
	let body;
	try { body = await readJsonBody(req); }
	catch {
		res.writeHead(400, { "content-type": "application/json; charset=utf-8" });
		res.end(JSON.stringify({ error: "bad request" }));
		return;
	}
	const args = body && typeof body.arguments === "object" && body.arguments !== null ? body.arguments : {};
	const messages = args.messages ?? [];
	if (!Array.isArray(messages) || messages.length === 0) {
		res.writeHead(200, { "content-type": "application/json; charset=utf-8" });
		res.end(JSON.stringify({ output: "", is_error: false }));
		return;
	}
	const harnessMessages = toHarnessMessages(messages);
	const controller = new AbortController();
	req.on("close", () => controller.abort());
	let content = "";
	let finishReason = "stop";
	try {
		const stream = llm.stream({
			provider: cfg.provider,
			model: cfg.model,
			messages: harnessMessages,
			signal: controller.signal,
		});
		for await (const chunk of stream) {
			if (!chunk || typeof chunk !== "object") continue;
			if (chunk.type === "text-delta" && typeof chunk.text === "string") content += chunk.text;
			else if (chunk.type === "finish" && chunk.reason?.kind) {
				finishReason = chunk.reason.kind === "error" ? "error" : "stop";
			}
		}
	} catch (err) {
		res.writeHead(200, { "content-type": "application/json; charset=utf-8" });
		res.end(JSON.stringify({ output: "", is_error: true, error: String(err) }));
		return;
	}
	res.writeHead(200, { "content-type": "application/json; charset=utf-8" });
	res.end(JSON.stringify({ output: content, is_error: finishReason === "error" }));
}

/**
 * Handle one chat completion through DSH's own llm channel.
 */
export async function handleChat(req, res, cfg, llm) {
	let body;
	try {
		body = await readJsonBody(req);
	} catch {
		res.writeHead(400, { "content-type": "application/json; charset=utf-8" });
		res.end(JSON.stringify({ error: "bad request: invalid JSON body" }));
		return;
	}

	let provider = cfg.provider;
	let model = cfg.model;
	if (cfg.allowModelOverride && typeof body.model === "string" && body.model.trim() !== "") {
		model = body.model.trim();
	}
	// DEBUG_DUMP: 记录 NEKO 发来的对话请求结构（tools/messages）
	{
		const dbg = {
			ts: new Date().toISOString(),
			has_tools: Array.isArray(body.tools) && body.tools.length > 0,
			tools_count: Array.isArray(body.tools) ? body.tools.length : 0,
			tools_preview: Array.isArray(body.tools) ? body.tools.slice(0, 5).map(t => ({ name: t?.function?.name, desc: (t?.function?.description||"").slice(0,80) })) : null,
			has_tool_choice: body.tool_choice !== undefined,
			tool_choice: body.tool_choice,
			messages_roles: (body.messages||[]).map(m => ({ r: m?.role, keys: Object.keys(m||{}), tc: m?.tool_calls ? m.tool_calls.length : 0 })),
			n_msg: (body.messages||[]).length,
		};
		try { fs.appendFileSync("D:\\AI工作文件夹\\neko_req_dump.jsonl", JSON.stringify(dbg)+"\n"); } catch {}
	}
	const wishesStream = body.stream === true;
	const messages = toHarnessMessages(body.messages ?? []);
	const controller = new AbortController();
	req.on("close", () => controller.abort());

	let llmStream;
	try {
		llmStream = llm.stream({
			provider,
			model,
			messages,
			signal: controller.signal,
		});
	} catch (err) {
		res.writeHead(502, { "content-type": "application/json; charset=utf-8" });
		res.end(JSON.stringify({ error: "dsh llm unavailable: " + String(err) }));
		return;
	}

	if (!wishesStream) {
		// Non-streaming: collect text deltas, return a single completion.
		let content = "";
		let finishReason = "stop";
		try {
			for await (const chunk of llmStream) {
				if (!chunk || typeof chunk !== "object") continue;
				if (chunk.type === "text-delta" && typeof chunk.text === "string") content += chunk.text;
				else if (chunk.type === "finish" && chunk.reason?.kind) {
					finishReason = chunk.reason.kind === "error" ? "error" : "stop";
				}
			}
		} catch (err) {
			res.writeHead(502, { "content-type": "application/json; charset=utf-8" });
			res.end(JSON.stringify({ error: "llm stream error: " + String(err) }));
			return;
		}
		const out = {
			id: "chatcmpl-" + Math.random().toString(36).slice(2),
			object: "chat.completion",
			created: Math.floor(Date.now() / 1000),
			model,
			choices: [{ index: 0, message: { role: "assistant", content }, finish_reason: finishReason }],
		};
		const text = JSON.stringify(out);
		res.writeHead(200, { "content-type": "application/json; charset=utf-8", "content-length": Buffer.byteLength(text) });
		res.end(text);
		return;
	}

	// Streaming: relay text deltas as OpenAI SSE format.
	res.writeHead(200, {
		"content-type": "text/event-stream",
		"cache-control": "no-cache",
		connection: "keep-alive",
	});
	const send = (obj) => {
		try { res.write("data: " + JSON.stringify(obj) + "\n\n"); } catch { /* swallowed */ }
	};
	try {
		for await (const chunk of llmStream) {
			if (!chunk || typeof chunk !== "object") continue;
			if (chunk.type === "text-delta" && typeof chunk.text === "string") {
				send({
					id: "chatcmpl-" + Math.random().toString(36).slice(2),
					object: "chat.completion.chunk",
					created: Math.floor(Date.now() / 1000),
					model,
					choices: [{ index: 0, delta: { content: chunk.text }, finish_reason: null }],
				});
			} else if (chunk.type === "finish") {
				const fr = chunk.reason?.kind === "error" ? "error" : "stop";
				send({
					id: "chatcmpl-",
					object: "chat.completion.chunk",
					created: Math.floor(Date.now() / 1000),
					model,
					choices: [{ index: 0, delta: {}, finish_reason: fr }],
				});
			}
		}
	} catch {
		// client disconnected mid-stream
	} finally {
		try { res.write("data: [DONE]\n\n"); } catch { /* swallowed */ }
		try { res.end(); } catch { /* swallowed */ }
	}
}

/** Register the plugin routes on the shared webServer. */
export function apply(ctx, config) {
	ctx.effect(() => {
		const chat = ctx.webServer.register({
			kind: "exact",
			path: "/v1/chat/completions",
			handler: (req, res) => {
				if (req.method !== "POST") {
					res.writeHead(405);
					res.end();
					return;
				}
				return handleChat(req, res, config, ctx.llm);
			},
		});
		const health = ctx.webServer.register({
			kind: "exact",
			path: "/v1/health",
			handler: (_req, res) => {
				res.writeHead(200, { "content-type": "application/json; charset=utf-8" });
				res.end(JSON.stringify({ ok: true, service: "dsh-external-brain", provider: config.provider, model: config.model }));
			},
		});
		const tool = ctx.webServer.register({
			kind: "exact",
			path: "/tools/external_chat",
			handler: (req, res) => {
				if (req.method !== "POST") {
					res.writeHead(405);
					res.end();
					return;
				}
				return handleToolCallback(req, res, config, ctx.llm);
			},
		});
		return () => { chat(); health(); tool(); };
	}, "dsh-external-brain: routes");
}
